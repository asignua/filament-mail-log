includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    ignoreErrors:
        # Traits for the host's own models / mailables: nothing inside the package uses them.
        -
            identifier: trait.unused
            path: src/Concerns/*
